{
    "manifest_version": 3,
    "name": "Network Tracker",
    "version": "1.0.0",
    "action": {
        "default_popup": "src/popup/index.html"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.tsx"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "hook.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}